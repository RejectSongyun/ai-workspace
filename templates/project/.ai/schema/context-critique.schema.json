{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "retrieval_episode": {
      "type": "string",
      "minLength": 1
    },
    "source_manifest": {
      "type": "string",
      "minLength": 1
    },
    "provided": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "revision_or_sha256": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "reference",
          "revision_or_sha256",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "actually_used": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "revision_or_sha256": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "reference",
          "revision_or_sha256",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "unnecessary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisive": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retrieval_quality": {
      "type": "object",
      "properties": {
        "assessment": {
          "enum": [
            "unknown",
            "poor",
            "mixed",
            "good"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "revision_or_sha256": {
                "type": "string",
                "minLength": 1
              },
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reference",
              "revision_or_sha256",
              "event_id",
              "claim"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "assessment",
        "method",
        "coverage",
        "uncertainty",
        "evidence"
      ],
      "additionalProperties": false
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "enum": [
              "project",
              "protocol"
            ]
          },
          "change": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "const": "candidate"
          }
        },
        "required": [
          "scope",
          "change",
          "evidence_ids",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "task",
    "retrieval_episode",
    "source_manifest",
    "provided",
    "actually_used",
    "missing",
    "unnecessary",
    "decisive",
    "retrieval_quality",
    "recommendations"
  ],
  "additionalProperties": false
}
