{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "required": [
    "id",
    "type",
    "scope",
    "level",
    "statement",
    "rationale",
    "source",
    "authority",
    "status",
    "introduced_by",
    "validity"
  ],
  "additionalProperties": false,
  "properties": {
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "candidate",
        "approved",
        "stale",
        "deprecated",
        "superseded",
        "rejected"
      ]
    },
    "level": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "introduced_by": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "reference",
          "revision"
        ],
        "properties": {
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validity": {
      "type": "object",
      "required": [
        "checked_at",
        "source_revision"
      ],
      "properties": {
        "checked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "type": "object"
}
