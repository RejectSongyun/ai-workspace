{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "retired"
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "revision_or_sha256": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "revision_or_sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scenario",
        "artifacts",
        "scope"
      ],
      "additionalProperties": false
    },
    "expected_behavior": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "forbidden_behavior": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "pass_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "failure_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "rubric_revision": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "not_run",
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "revision_or_sha256": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "revision_or_sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "method",
        "pass_criteria",
        "failure_criteria",
        "metrics",
        "rubric_revision",
        "result",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "status",
    "input",
    "expected_behavior",
    "forbidden_behavior",
    "evaluation"
  ],
  "additionalProperties": false
}
