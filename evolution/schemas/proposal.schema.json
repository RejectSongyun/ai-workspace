{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "evaluating",
        "ready_for_review",
        "accepted",
        "rejected",
        "withdrawn"
      ]
    },
    "based_on": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision_or_sha256": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "revision_or_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "change": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "Add",
            "Modify",
            "Deprecate",
            "Remove",
            "Merge",
            "Split"
          ]
        },
        "input_rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "output_rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "lifecycle": {
          "enum": [
            "experimental",
            "candidate",
            "stable",
            "deprecated",
            "removed"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "exact_diff": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "revision_or_sha256": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "revision_or_sha256"
          ],
          "additionalProperties": false
        },
        "benefit": {
          "type": "object",
          "properties": {
            "quality": {
              "type": "string",
              "minLength": 1
            },
            "reliability": {
              "type": "string",
              "minLength": 1
            },
            "context_tokens": {
              "type": "string",
              "minLength": 1
            },
            "latency": {
              "type": "string",
              "minLength": 1
            },
            "human_effort": {
              "type": "string",
              "minLength": 1
            },
            "maintenance": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "quality",
            "reliability",
            "context_tokens",
            "latency",
            "human_effort",
            "maintenance"
          ],
          "additionalProperties": false
        },
        "cost": {
          "type": "object",
          "properties": {
            "quality": {
              "type": "string",
              "minLength": 1
            },
            "reliability": {
              "type": "string",
              "minLength": 1
            },
            "context_tokens": {
              "type": "string",
              "minLength": 1
            },
            "latency": {
              "type": "string",
              "minLength": 1
            },
            "human_effort": {
              "type": "string",
              "minLength": 1
            },
            "maintenance": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "quality",
            "reliability",
            "context_tokens",
            "latency",
            "human_effort",
            "maintenance"
          ],
          "additionalProperties": false
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "compatibility": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "operation",
        "input_rule_ids",
        "output_rule_ids",
        "lifecycle",
        "statement",
        "exact_diff",
        "benefit",
        "cost",
        "alternatives",
        "compatibility",
        "rollback"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "baseline": {
            "type": [
              "number",
              "null"
            ]
          },
          "candidate": {
            "type": [
              "number",
              "null"
            ]
          },
          "threshold_or_budget": {
            "type": "string",
            "minLength": 1
          },
          "sample_size": {
            "type": "integer",
            "minimum": 0
          },
          "uncertainty": {
            "type": "string",
            "minLength": 1
          },
          "measurement_reference": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "baseline",
          "candidate",
          "threshold_or_budget",
          "sample_size",
          "uncertainty",
          "measurement_reference"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evaluation_plan": {
      "type": "string",
      "minLength": 1
    },
    "human_approval": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_artifact_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "exception_approved": {
          "type": "boolean"
        }
      },
      "required": [
        "decision",
        "reviewer",
        "reviewed_at",
        "source_reference",
        "approved_artifact_sha256",
        "scope",
        "rationale",
        "exception_approved"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "minLength": 1
              },
              "source_reference": {
                "type": "string",
                "minLength": 1
              },
              "approved_artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "status",
    "based_on",
    "hypothesis",
    "change",
    "metrics",
    "guardrails",
    "evaluation_plan",
    "human_approval"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "human_approval": {
            "properties": {
              "decision": {
                "const": "approved"
              }
            }
          }
        }
      }
    }
  ]
}
