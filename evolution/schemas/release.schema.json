{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "released",
        "rolled_back"
      ]
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision_or_sha256": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "revision_or_sha256"
      ],
      "additionalProperties": false
    },
    "artifact_manifest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision_or_sha256": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "revision_or_sha256"
      ],
      "additionalProperties": false
    },
    "accepted_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision_or_sha256": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "revision_or_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "rejected_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision_or_sha256": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "revision_or_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "deprecated_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision_or_sha256": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "revision_or_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision_or_sha256": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "revision_or_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "experiments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "revision_or_sha256": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "revision_or_sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "benchmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "revision_or_sha256": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "revision_or_sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "outcome": {
          "enum": [
            "not_run",
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "exception_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "residual_risk": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "experiments",
        "benchmarks",
        "outcome",
        "exception_reason",
        "residual_risk"
      ],
      "additionalProperties": false
    },
    "human_approval": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_artifact_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "exception_approved": {
          "type": "boolean"
        }
      },
      "required": [
        "decision",
        "reviewer",
        "reviewed_at",
        "source_reference",
        "approved_artifact_sha256",
        "scope",
        "rationale",
        "exception_approved"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "minLength": 1
              },
              "source_reference": {
                "type": "string",
                "minLength": 1
              },
              "approved_artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "compatibility": {
      "type": "string",
      "minLength": 1
    },
    "adoption": {
      "type": "string",
      "minLength": 1
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "applied_artifact_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "released_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "status",
    "protocol_version",
    "baseline",
    "artifact_manifest",
    "accepted_changes",
    "rejected_changes",
    "deprecated_changes",
    "evidence",
    "evaluation",
    "human_approval",
    "compatibility",
    "adoption",
    "rollback",
    "applied_artifact_sha256",
    "released_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "released"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "human_approval": {
            "properties": {
              "decision": {
                "const": "approved"
              }
            }
          },
          "evaluation": {
            "anyOf": [
              {
                "properties": {
                  "outcome": {
                    "const": "pass"
                  },
                  "experiments": {
                    "minItems": 1
                  },
                  "benchmarks": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "exception_reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "released"
          }
        }
      },
      "then": {
        "properties": {
          "applied_artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "released_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "released"
            ]
          },
          "evaluation": {
            "properties": {
              "exception_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "human_approval": {
            "properties": {
              "exception_approved": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
